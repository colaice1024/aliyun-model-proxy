PORT=3300

# 客户端调用本代理时使用的唯一密钥
PROXY_API_KEY=sk-001

# 你的阿里云百炼大模型密钥，请勿发送给客户端。
# 支持配置多个密钥（逗号分隔），实现多账号兜底：
# 当前账号所有模型额度用尽后，自动切换到下一个账号。
# 每个账号下共享同一个 MODEL_IDS 模型池，代理会逐个尝试模型。
DASHSCOPE_API_KEYS=sk-change-me-1

# DashScope Anthropic 兼容协议的基础 URL
UPSTREAM_BASE_URL=https://dashscope.aliyuncs.com/apps/anthropic

# DashScope OpenAI 兼容协议（Chat Completions）的基础 URL
OPENAI_UPSTREAM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 文本模型，逗号分隔的模型池，代理会用其中之一覆盖请求体中的 "model" 字段
MODEL_IDS=deepseek-v4-flash-0731,qwen3.7-flash-2026-07-15,qwen3.7-flash,qwen3-vl-235b-a22b-thinking,qwen3-vl-32b-thinking,qwen-max,qwen3-vl-30b-a3b-thinking,qwen3-32b,qwen3.5-35b-a3b,qwen3-coder-480b-a35b-instruct,qwen3-coder-plus,qwen3-vl-8b-thinking,qwen3-vl-flash-2025-10-15,qwen3-max-preview,qwen3.5-flash-2026-02-23,qwen-plus-0112,qwen-plus,qwen-turbo,qwen3-next-80b-a3b-thinking,qwen3.5-27b,MiniMax-M2.5,qwen-plus-2025-12-01,qwen3-max-2025-09-23,MiniMax-M2.1,qwen3-30b-a3b-instruct-2507,qwen-flash,qwen-flash-2025-07-28,qwen3-235b-a22b-instruct-2507,qwen3-coder-plus-2025-07-22,kimi-k2.5,qwen3.5-plus-2026-04-20,kimi-k2.6,qwen-plus-1220,qwen3.5-122b-a10b,qwen3-max,qwen3.5-plus-2026-02-15,qwen3-235b-a22b-thinking-2507,kimi-k2-thinking,kimi-k2.7-code,deepseek-v3.1,qwen3.5-397b-a17b,qwen3-vl-plus-2025-09-23,deepseek-v3.2,qwen3-coder-next,qwen3.5-flash,qwen3-vl-32b-instruct,qwen3-30b-a3b-thinking-2507,qwen3-coder-plus-2025-09-23,qwen-plus-latest,Moonshot-Kimi-K2-Instruct,qwen3-max-2026-01-23,qwen-plus-2025-09-11,qwen3-vl-flash-2026-01-22,qwen-vl-max,qwen3-vl-30b-a3b-instruct,qwen3-vl-235b-a22b-instruct,qwen3-coder-30b-a3b-instruct,qwen3-235b-a22b,qwen-coder-plus,qwen-plus-2025-01-25,qwen3-vl-plus,qwen3-30b-a3b,glm-4.5,glm-4.6,qwen-coder-turbo,qwen3-vl-8b-instruct,glm-4.7,qwen3-coder-flash-2025-07-28,deepseek-v3,qwen3-vl-plus-2025-12-19,qwen-plus-2025-04-28,qwen-plus-2025-07-14,qwq-plus,qwen3-next-80b-a3b-instruct

# 图片模型，暂未接入
IMAGE_MODEL_IDS=qwen-image-2.0-pro-2026-04-22,wan2.7-image-pro,wan2.7-image

# 免费额度耗尽后，该密钥+模型组合的禁用时长（秒）。默认 30 天。
MODEL_COOLDOWN_SECONDS=2592000

# 用于持久化冷却状态的 JSON 文件路径，重启后状态不丢失
STATE_PATH=./data/proxy-state.json

# authorization: 使用 Authorization: Bearer <key>
# x-api-key: 使用 x-api-key: <key>
# both: 同时发送以上两个请求头
UPSTREAM_AUTH_MODE=authorization

# 设为 false 可禁用 CORS；否则填 * 或指定具体的来源地址
CORS_ORIGIN=*
